      "position": "right",
      "widthRatio": 0.45,
      "top": 3001,
      "tag": "li",
      "kind": "statement"
     },
     {
      "text": "Melegislasi aturan kelembagaan kemahasiswaan di lingkungan fakultas.",
      "words": 7,
      "chars": 68,
      "lines": 2,
      "size": 27.7,
      "vw": 1.9,

      "tag": "p",
      "kind": "statement"
     },
     {
      "text": "Tugas dan fungsi.",
      "words": 3,
      "chars": 17,
      "lines": 1,
      "size": 59.8,
      "vw": 4.2,
      "font": "Young Serif",

---
import "../styles/global.css";
import { site, kreditFoto } from "../data/site.js";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Situs resmi Dewan Perwakilan Mahasiswa, Fakultas Ilmu Komputer, Universitas Djuanda." } = Astro.props;

const nav = [
  { href: "/", label: "Beranda" },
  { href: "/profil/", label: "Profil" },
  { href: "/struktur/", label: "Struktur" },
  { href: "/dokumentasi/", label: "Dokumentasi" },
];
const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));
const waLink = `https://wa.me/${site.waNumber}`;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | {site.short}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/webp" href="/images/logo-dpm.webp" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Epilogue:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
    <style is:inline>
      /* the sticky nav depends on clip, never hidden (base.css carries the same pair) */
      html,
      body {
        overflow-x: clip;
      }
    </style>
  </head>
  <body>
    <a class="skip-link" href="#main">Lewati ke konten utama</a>

    <header class="site-nav">
      <div class="nav-shell container">
        <a class="wordmark" href="/">
          <img src="/images/logo-dpm.webp" alt="Logo DPM FILKOM UNIDA" width="32" height="32" />
          <span>DPM FILKOM UNIDA</span>
        </a>
        <nav class="nav-links" aria-label="Navigasi utama">
          {nav.map((n) => <a href={n.href} aria-current={isCurrent(n.href) ? "page" : undefined}>{n.label}</a>)}
        </nav>
        <a class="nav-cta" href="/aduan/" aria-current={isCurrent("/aduan/") ? "page" : undefined}>Aduan</a>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-foot container">
      <div class="foot-top">
        <div class="foot-brand">
          <p class="foot-name">DPM FILKOM<br />UNIDA</p>
          <p class="foot-line">Menampung, mengawal, dan memperjuangkan suara mahasiswa fakultas.</p>
        </div>

        <div class="foot-cols">
          <div class="foot-col">
            <p class="foot-col-title">Situs</p>
            <nav aria-label="Navigasi footer">
              <a href="/profil/">Profil</a>
              <a href="/struktur/">Struktur</a>
              <a href="/aduan/">Aduan</a>
              <a href="/dokumentasi/">Dokumentasi</a>
            </nav>
          </div>
          <div class="foot-col">
            <p class="foot-col-title">Jalur resmi</p>
            <p><a href={waLink}>WhatsApp pengurus</a></p>
            {site.instagram && <p><a href={`https://instagram.com/${site.instagram}`}>@{site.instagram}</a></p>}
            {site.email && <p><a href={`mailto:${site.email}`}>{site.email}</a></p>}
            {!site.instagram && !site.email && <p>Instagram dan email segera diumumkan.</p>}
          </div>
          <div class="foot-col">
            <p class="foot-col-title">Sekretariat</p>
            <p>{site.city}.</p>
          </div>
        </div>
      </div>

      <div class="foot-bottom">
        <span>© {new Date().getFullYear()} {site.short}</span>
        <span>{kreditFoto}</span>
        <span>Situs statis. Tidak menyimpan data aduan.</span>
      </div>
    </footer>
  </body>
</html>

---
import "../styles/global.css";
import { site, kreditFoto } from "../data/site.js";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Situs resmi Dewan Perwakilan Mahasiswa, Fakultas Ilmu Komputer, Universitas Djuanda." } = Astro.props;

const nav = [
  { href: "/", label: "Beranda" },
  { href: "/profil/", label: "Profil" },
  { href: "/struktur/", label: "Struktur" },
  { href: "/dokumentasi/", label: "Dokumentasi" },
];
const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));
const waLink = `https://wa.me/${site.waNumber}`;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | {site.short}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/webp" href="/images/logo-dpm.webp" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&family=Young+Serif&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
    <noscript>
      <style>
        [data-reveal] { opacity: 1 !important; transform: none !important; }
      </style>
    </noscript>
  </head>
  <body>
    <a class="skip-link" href="#main">Lewati ke konten utama</a>

    <header class="site-head wrap">
      <div class="axis">
        <a class="wordmark" href="/">
          <img src="/images/logo-dpm.webp" alt="Logo DPM FILKOM UNIDA" width="34" height="34" />
          <span>DPM FILKOM UNIDA</span>
        </a>
        <nav class="main-nav" aria-label="Navigasi utama">
          {nav.map((n) => <a href={n.href} aria-current={isCurrent(n.href) ? "page" : undefined}>{n.label}</a>)}
          <a class="nav-cta" href="/aduan/" aria-current={isCurrent("/aduan/") ? "page" : undefined}>Aduan</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-foot wrap">
      <p class="foot-name"><span>DPM FILKOM</span> <span>UNIDA</span></p>
      <p class="foot-line">Menampung, mengawal, dan memperjuangkan suara mahasiswa fakultas.</p>

      <div class="foot-grid">
        <nav class="foot-nav" aria-label="Navigasi footer">
          <a href="/profil/">Profil</a>
          <a href="/struktur/">Struktur</a>
          <a href="/aduan/">Aduan</a>
          <a href="/dokumentasi/">Dokumentasi</a>
        </nav>
        <div class="foot-credits">
          <p>{site.city}.</p>
          <p>
            <a href={waLink}>WhatsApp pengurus</a>
            {site.instagram && <> · <a href={`https://instagram.com/${site.instagram}`}>@{site.instagram}</a></>}
            {site.email && <> · <a href={`mailto:${site.email}`}>{site.email}</a></>}
            {!site.instagram && !site.email && <> · Instagram dan email segera diumumkan.</>}
          </p>
          <p style="margin-top: 12px;">{kreditFoto}</p>
        </div>
      </div>

      <div class="foot-bottom">
        <span>© {new Date().getFullYear()} {site.short}</span>
        <span>Situs statis. Tidak menyimpan data aduan.</span>
      </div>
    </footer>

    <script is:inline>
      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const reveals = document.querySelectorAll("[data-reveal]");
      if (reduced || !("IntersectionObserver" in window)) {
        reveals.forEach((el) => el.classList.add("is-in"));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-in");
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12 }
        );
        reveals.forEach((el) => io.observe(el));
      }

      const scene = document.querySelector("[data-deck-scene]");
      if (scene) {
        const cards = [...scene.querySelectorAll(".kcard")];
        const mobile = window.matchMedia("(max-width: 860px)");
        let step = 0;

        const live = () => !mobile.matches && !reduced;

        const apply = (next) => {
          step = next;
          cards.forEach((card, i) => {
            card.dataset.state = i < next ? "spine" : i === next ? "current" : "next";
          });
        };

        const onScroll = () => {
          if (!live()) return;
          const top = scene.getBoundingClientRect().top + window.scrollY;
          const travel = scene.offsetHeight - window.innerHeight;
          const progress = Math.min(1, Math.max(0, (window.scrollY - top) / travel));
          const next = Math.round(progress * (cards.length - 1));
          if (next !== step) apply(next);
        };

        const jump = (i) => {
          if (!live()) return;
          const top = scene.getBoundingClientRect().top + window.scrollY;
          const travel = scene.offsetHeight - window.innerHeight;
          window.scrollTo({ top: top + (i / (cards.length - 1)) * travel + 2, behavior: "smooth" });
        };

        const sync = () => {
          const on = live();
          scene.classList.toggle("deck-live", on);
          if (on) {
            apply(step);
            onScroll();
          } else {
            cards.forEach((card) => card.removeAttribute("data-state"));
          }
        };

        cards.forEach((card, i) => {
          const spine = card.querySelector(".kspine");
          if (spine) spine.addEventListener("click", () => jump(i));
        });

        sync();
        window.addEventListener("scroll", onScroll, { passive: true });
        window.addEventListener("resize", sync);
        mobile.addEventListener("change", sync);
      }
    </script>
  </body>
</html>

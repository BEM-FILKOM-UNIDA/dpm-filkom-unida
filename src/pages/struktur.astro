---
import Layout from "../layouts/Layout.astro";
import { pimpinan, pembina, komisi, plates } from "../data/site.js";

const bandPlate = plates[1];

const orang = [...pimpinan, { nama: pembina.nama, peran: pembina.peran }];
---

<Layout
  title="Struktur"
  description="Struktur organisasi DPM FILKOM UNIDA: pimpinan, komisi legislasi, komisi kepengawasan, dan komisi anggaran."
>
  <header class="page-head wrap">
    <div class="axis">
      <p class="side" data-reveal>Struktur organisasi</p>
      <h1 data-reveal>Struktur</h1>
      <p class="standfirst" data-reveal>
        Pimpinan, tiga komisi kerja, dan pembina. Nama pengurus diperbarui setelah rapat pleno.
      </p>
    </div>
    <figure class="plate band" data-reveal>
      <img
        src={bandPlate.img}
        alt={bandPlate.alt}
        width={bandPlate.width}
        height={bandPlate.height}
        loading="lazy"
      />
      <figcaption>{bandPlate.caption}<span class="credit">{bandPlate.credit}</span></figcaption>
    </figure>
  </header>

  <section class="wrap" aria-labelledby="pimpinan-title">
    <div class="axis">
      <div>
        <p class="side">Periode berjalan</p>
        <p class="aside-note" data-reveal>
          Pimpinan memimpin rapat pleno, mewakili DPM di forum fakultas, dan menjaga jalannya tiga
          komisi.
        </p>
      </div>
      <div class="col-2">
        <h2 id="pimpinan-title">Pimpinan.</h2>
      </div>
    </div>
    <div class="people mt-40" data-reveal>
      {orang.map((o) => (
        <div class="person">
          <span class="role">{o.peran}</span>
          <span class="name">{o.nama}</span>
        </div>
      ))}
    </div>
  </section>

  <section class="wrap" aria-labelledby="komisi-kerja-title">
    <div class="axis">
      <p class="side">Tiga komisi kerja</p>
      <div class="col-2">
        <h2 id="komisi-kerja-title">Komisi kerja.</h2>
      </div>
    </div>
    <div class="komisi-list mt-40">
      {komisi.map((k) => (
        <article class="komisi-row" id={k.id} data-reveal>
          <div>
            <p class="small">{k.fokus}</p>
            <h3>{k.nama}</h3>
          </div>
          <div class="body">
            <p>{k.tugas}</p>
            <p class="anggota">Anggota: {k.anggota.join(", ")}.</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="visi wrap" aria-labelledby="struktur-cta">
    <div class="axis">
      <div></div>
      <div class="col-2" data-reveal>
        <h2 id="struktur-cta">Aduan masuk lewat komisi yang tepat.</h2>
        <p class="lead mt-24">
          Tulis aduanmu di kartu aspirasi. Kategori yang kamu pilih menentukan komisi yang
          menindaklanjuti.
        </p>
        <p class="mt-40"><a class="btn btn-accent" href="/aduan/">Sampaikan aduan</a></p>
      </div>
    </div>
  </section>
</Layout>

---
import Layout from "../layouts/Layout.astro";
import { pimpinan, pembina, komisi, plates } from "../data/site.js";

const bandPlate = plates[1];

const orang = [...pimpinan, { nama: pembina.nama, peran: pembina.peran }];
---

<Layout
  title="Struktur"
  description="Struktur organisasi DPM FILKOM UNIDA: pimpinan, komisi legislasi, komisi kepengawasan, dan komisi anggaran."
>
  <header class="page-head container">
    <div class="page-head-inner">
      <h1>Struktur</h1>
      <p class="label">Struktur organisasi</p>
      <p class="standfirst">
        Pimpinan, tiga komisi kerja, dan pembina. Nama pengurus diperbarui setelah rapat pleno.
      </p>
    </div>
  </header>

  <section class="archive" aria-label="Foto arsip">
    <div class="container">
      <figure class="plate">
        <img
          src={bandPlate.img}
          alt={bandPlate.alt}
          width={bandPlate.width}
          height={bandPlate.height}
          loading="eager"
          fetchpriority="high"
        />
        <figcaption>{bandPlate.caption}<span class="credit">{bandPlate.credit}</span></figcaption>
      </figure>
    </div>
  </section>

  <section class="section" aria-labelledby="pimpinan-title">
    <div class="container">
      <div class="section-head section-head--label">
        <h2 id="pimpinan-title">Pimpinan.</h2>
        <p class="label">Periode berjalan</p>
        <p class="lead">
          Pimpinan memimpin rapat pleno, mewakili DPM di forum fakultas, dan menjaga jalannya tiga
          komisi.
        </p>
      </div>

      <div class="register">
        {orang.map((o) => (
          <div class="person">
            <span class="role">{o.peran}</span>
            <span class="name">{o.nama}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section band" aria-labelledby="komisi-kerja-title">
    <div class="container">
      <div class="section-head section-head--label">
        <h2 id="komisi-kerja-title">Komisi kerja.</h2>
        <p class="label">Tiga komisi kerja</p>
      </div>

      <div class="rows">
        {komisi.map((k) => (
          <article class="row komisi-row" id={k.id}>
            <div class="row-title">
              <h3>{k.nama}</h3>
              <p class="members">{k.fokus}</p>
            </div>
            <div class="row-body">
              <p>{k.tugas}</p>
              <p class="members">Anggota: {k.anggota.join(", ")}.</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section band--ink" aria-labelledby="struktur-cta">
    <div class="container">
      <div class="split">
        <h2 id="struktur-cta">Aduan masuk lewat komisi yang tepat.</h2>
        <div class="prose">
          <p>
            Tulis aduanmu di kartu aspirasi. Kategori yang kamu pilih menentukan komisi yang
            menindaklanjuti.
          </p>
          <p><a class="btn" href="/aduan/">Sampaikan aduan</a></p>
        </div>
      </div>
    </div>
  </section>
</Layout>

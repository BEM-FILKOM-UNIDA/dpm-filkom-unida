---
import Layout from "../layouts/Layout.astro";
import { site, kategoriAduan } from "../data/site.js";
---

<Layout
  title="Kartu Aspirasi"
  description="Sampaikan aduan mahasiswa FILKOM UNIDA lewat Kartu Aspirasi. Isi, periksa, lalu kirim melalui WhatsApp."
>
  <header class="page-head page-head--tight container">
    <div class="page-head-inner">
      <h1>Kartu Aspirasi</h1>
      <p class="label">Aduan mahasiswa</p>
      <p class="standfirst">
        Satu kartu untuk satu aduan. Isi, periksa pratinjaunya, lalu kirim lewat WhatsApp. Tanpa
        akun, tanpa basis data.
      </p>
    </div>
  </header>

  <section class="section" aria-labelledby="form-title">
    <div class="container aduan-grid">
      <div class="aduan-form-col">
        <h2 class="form-title" id="form-title">Isi kartu</h2>
        <form class="form" id="aduan-form" data-wa={site.waNumber}>
          <div class="field">
            <label for="nama">Nama lengkap</label>
            <input id="nama" name="nama" type="text" autocomplete="name" required placeholder="Nama kamu" />
          </div>
          <div class="form-row">
            <div class="field">
              <label for="nim">NIM</label>
              <input id="nim" name="nim" type="text" inputmode="numeric" required placeholder="NIM kamu" />
            </div>
            <div class="field">
              <label for="kategori">Kategori</label>
              <select id="kategori" name="kategori" required>
                <option value="" disabled selected>Pilih kategori</option>
                {kategoriAduan.map((k) => <option value={k}>{k}</option>)}
              </select>
            </div>
          </div>
          <div class="field">
            <label for="pesan">Isi aduan</label>
            <textarea
              id="pesan"
              name="pesan"
              required
              placeholder="Tulis aduan secara jelas: apa, di mana, kapan, dan dampaknya."
            ></textarea>
          </div>
          <p class="form-note">
            Data tidak disimpan di situs ini. Setelah dikirim, pesan terbuka di WhatsApp kamu dan
            bisa kamu periksa sebelum mengirim.
          </p>
          <button class="btn btn--primary" type="submit">Kirim lewat WhatsApp</button>
          <p class="form-status" id="form-status" role="status" aria-live="polite" tabindex="-1"></p>
          <p class="form-note"><a class="link" id="wa-fallback" href="#" hidden>Buka WhatsApp</a></p>
        </form>
      </div>

      <aside class="kartu" id="kartu" aria-label="Pratinjau kartu aspirasi">
        <div class="kartu-head">
          <p class="kartu-title">Kartu Aspirasi</p>
          <img class="kartu-logo" src="/images/logo-dpm.webp" alt="" width="40" height="40" />
        </div>
        <dl>
          <dt>Nama</dt>
          <dd id="kartu-nama">Belum diisi</dd>
          <dt>NIM</dt>
          <dd id="kartu-nim">Belum diisi</dd>
          <dt>Kategori</dt>
          <dd id="kartu-kategori">Belum diisi</dd>
          <dt>Tanggal</dt>
          <dd id="kartu-tanggal"></dd>
        </dl>
        <p class="kartu-isi empty" id="kartu-pesan">Tulis aduanmu di formulir.</p>
        <p class="kartu-foot">DPM FILKOM UNIDA · {site.city}</p>
        <div class="stamp" aria-hidden="true">TERKIRIM</div>
      </aside>
    </div>
  </section>

  <section class="section band" aria-labelledby="alur-title">
    <div class="container">
      <div class="section-head section-head--label">
        <h2 id="alur-title">Alur aduan.</h2>
        <p class="label">Setelah dikirim</p>
      </div>
      <div class="split">
        <ol class="tugas-list col-inset">
          <li>Isi kartu dan periksa pratinjaunya di samping.</li>
          <li>Kirim lewat WhatsApp. Pesan terbuka dengan isi kartu yang sudah tersusun.</li>
          <li>Aduan dicatat dan diteruskan ke komisi sesuai kategori yang kamu pilih.</li>
        </ol>
      </div>
      <div class="split" style="margin-top: 32px;">
        <p class="form-note col-inset">
          {
            site.gformUrl ? (
              <a class="link" href={site.gformUrl}>Isi lewat Google Form</a>
            ) : (
              <>Jalur Google Form disiapkan. Selama belum aktif, gunakan form WhatsApp.</>
            )
          }
        </p>
      </div>
    </div>
  </section>

  <script is:inline>
    const form = document.getElementById("aduan-form");
    const kartu = document.getElementById("kartu");
    const status = document.getElementById("form-status");
    const fallback = document.getElementById("wa-fallback");
    const isi = document.getElementById("kartu-pesan");
    const tanggal = new Intl.DateTimeFormat("id-ID", { dateStyle: "long" }).format(new Date());
    const kosong = {
      nama: "Belum diisi",
      nim: "Belum diisi",
      kategori: "Belum diisi",
    };

    document.getElementById("kartu-tanggal").textContent = tanggal;

    const baca = () => ({
      nama: form.elements.nama.value.trim(),
      nim: form.elements.nim.value.trim(),
      kategori: form.elements.kategori.value,
      pesan: form.elements.pesan.value.trim(),
    });

    const sinkron = () => {
      const v = baca();
      for (const key of Object.keys(kosong)) {
        document.getElementById(`kartu-${key}`).textContent = v[key] || kosong[key];
      }
      isi.textContent = v.pesan || "Tulis aduanmu di formulir.";
      isi.classList.toggle("empty", !v.pesan);
    };

    form.addEventListener("input", sinkron);
    form.addEventListener("change", sinkron);
    sinkron();

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;

      const v = baca();
      const isiPesan = [
        "KARTU ASPIRASI DPM FILKOM UNIDA",
        `Nama: ${v.nama}`,
        `NIM: ${v.nim}`,
        `Kategori: ${v.kategori}`,
        `Tanggal: ${tanggal}`,
        "",
        v.pesan,
      ].join("\n");
      const url = `https://wa.me/${form.dataset.wa}?text=${encodeURIComponent(isiPesan)}`;

      kartu.classList.add("is-stamped");
      fallback.href = url;
      fallback.hidden = false;
      status.textContent = "Kartu siap. WhatsApp dibuka di tab baru.";
      status.focus();
      window.open(url, "_blank");
    });
  </script>
</Layout>

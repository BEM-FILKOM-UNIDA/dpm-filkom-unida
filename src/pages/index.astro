---
import Layout from "../layouts/Layout.astro";
import { site, fakta, prinsip, peran, komisi, plates, faq } from "../data/site.js";

const heroPlate = plates[0];
const contactPlate = plates[1];
---

<Layout title="Beranda">
  <section class="hero wrap" aria-labelledby="hero-title">
    <div class="hero-grid">
      <h1 id="hero-title">
        <span class="line"><span>Suara</span></span>
        <span class="line"><span>Mahasiswa</span></span>
      </h1>

      <div class="hero-copy">
        <p>
          Dewan Perwakilan Mahasiswa FILKOM UNIDA. Menampung dan mengawal suara mahasiswa.
        </p>
        <div>
          <a class="btn btn-accent" href="/aduan/">Sampaikan aduan</a>
        </div>
        <p class="small">Sekretariat {site.city}.</p>
      </div>

      <div class="hero-media">
        <div class="hero-badge">
          <strong>3</strong>
          <span>Komisi kerja di DPM.</span>
        </div>
        <figure class="hero-figure">
          <img
            src={heroPlate.img}
            alt={heroPlate.alt}
            width={heroPlate.width}
            height={heroPlate.height}
            loading="eager"
            fetchpriority="high"
          />
          <figcaption>{heroPlate.caption}</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="about wrap" aria-labelledby="about-title">
    <div class="axis">
      <div class="col-2" data-reveal>
        <h2 id="about-title">Antara mahasiswa dan fakultas.</h2>
        <div class="about-copy mt-40">
          <p>
            DPM FILKOM UNIDA adalah lembaga perwakilan mahasiswa di tingkat fakultas. Kami dipilih
            oleh mahasiswa, bekerja dengan mandat yang jelas, dan melapor kembali kepada mahasiswa.
          </p>
          <p class="mt-24">
            Kerja kami berputar di tiga hal: aturan yang dibaca dari sisi mahasiswa, anggaran yang
            bisa dipertanggungjawabkan, dan pengawasan yang tidak berhenti di ruang rapat.
          </p>
        </div>
      </div>
      <div class="about-side" data-reveal>
        <dl class="facts">
          {fakta.map((f) => (
            <div>
              <dt>{f.label}</dt>
              <dd>{f.value}</dd>
            </div>
          ))}
        </dl>
        <div class="about-foot">
          <p class="prinsip-label">Yang kami jaga</p>
          <div class="prinsip-cols" data-reveal>
            {prinsip.map((p) => (
              <div class="prinsip-item">
                <span>{p.nama}</span>
                <span>{p.catatan}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="features wrap" aria-labelledby="fungsi-title">
    <div class="axis">
      <div></div>
      <div data-reveal>
        <h2 id="fungsi-title">Tiga fungsi, satu meja kerja.</h2>
        <p class="lead" style="color: rgba(245,248,249,.82);">
          Kerja legislatif bukan slogan. Ini tiga hal yang kami kerjakan setiap semester.
        </p>
      </div>
    </div>

    {peran.map((p) => (
      <article class="feature-row" data-reveal>
        <div class="feature-main">
          <div class="feature-text">
            <h3>{p.name}</h3>
            <p>{p.body}</p>
          </div>
          <figure class="plate feature-plate" style={`--plate-w: ${p.width}px;`}>
            <img
              src={p.img}
              alt={p.alt}
              width="640"
              height="800"
              loading="lazy"
              style={`aspect-ratio: ${p.ratio};`}
            />
            <figcaption>
              {p.caption}
              <span class="credit">{p.credit}</span>
            </figcaption>
          </figure>
        </div>
      </article>
    ))}
  </section>

  <section class="komisi-scene" id="komisi" aria-labelledby="komisi-title" data-deck-scene>
    <div class="wrap komisi-stage">
      <div class="axis">
        <div></div>
        <div>
          <h2 id="komisi-title">Tiga komisi kerja.</h2>
          <p class="lead mt-24">Setiap aduan masuk ke komisi yang mengurusnya. Gulir untuk membuka tiap kartu.</p>
        </div>
      </div>

      <div class="deck">
        {komisi.map((k) => (
          <article class="kcard">
            <div class="kbody">
              <h3>{k.nama}</h3>
              <p>{k.ringkas}</p>
              <p>{k.tugas}</p>
              <div class="kfoot">
                <span>{k.fokus}</span>
                <a href={`/struktur/#${k.id}`}>Buka komisi</a>
              </div>
            </div>
            <button class="kspine" type="button" aria-label={`Buka ${k.nama}`}>
              <span>{k.nama}</span>
            </button>
          </article>
        ))}
      </div>

      <div class="deck-foot">
        <span>3 komisi kerja</span>
        <a href="/struktur/">Lihat struktur lengkap</a>
      </div>
    </div>
  </section>

  <section class="contact wrap" aria-labelledby="contact-title">
    <div class="contact-grid">
      <div class="contact-statement" data-reveal>
        <h2 id="contact-title">Hubungi DPM</h2>
        <p>Punya keluhan atau usul? Kirim lewat WhatsApp.</p>
        <p class="mt-24"><a class="text-link" href="/aduan/">Buka formulir aduan</a></p>
      </div>
      <figure class="plate contact-photo" data-reveal>
        <img src={contactPlate.img} alt={contactPlate.alt} width="340" height="340" loading="lazy" />
      </figure>
      <div class="contact-links" data-reveal>
        <p>Jalur resmi</p>
        <ul>
          <li><a class="text-link" href={`https://wa.me/${site.waNumber}`}>WhatsApp pengurus</a></li>
          {site.instagram && <li><a class="text-link" href={`https://instagram.com/${site.instagram}`}>@{site.instagram}</a></li>}
          {site.email && <li><a class="text-link" href={`mailto:${site.email}`}>{site.email}</a></li>}
          {!site.instagram && !site.email && <li class="small">Instagram dan email segera diumumkan.</li>}
        </ul>
        <p class="contact-city">{site.city}</p>
      </div>
    </div>
  </section>

  <section class="faq wrap" aria-labelledby="faq-title">
    <div class="faq-grid">
      <h2 id="faq-title">Pertanyaan umum.</h2>
      <div class="faq-cols" data-reveal>
        {faq.map((item) => (
          <p class="faq-item"><strong>{item.q}</strong> {item.a}</p>
        ))}
      </div>
    </div>
  </section>
</Layout>
